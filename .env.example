# SoundWave — copy to `.env` and fill in what you need. Everything is optional:
# with none of these set, the app still boots and serves the built-in seed catalog.

# Local music folder with your own audio files (mp3 / wav / m4a / ogg).
# Used by docker-compose for the read-only mount and by the backend when running on the host.
# Leave empty to disable the local disk provider entirely.
LOCAL_MUSIC_PATH=

# Google AI Studio API key — enables real Gemini recommendations.
# Without it, the backend uses its built-in heuristic recommendation engine.
GEMINI_API_KEY=

# Jamendo free API client id (https://developer.jamendo.com) — enables the Jamendo catalog provider.
JAMENDO_CLIENT_ID=

# Spring profile: `local` for development, `gcp` for Cloud Run.
SPRING_PROFILES_ACTIVE=local
